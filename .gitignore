# Retain final station data and evidence; keep research downloads local
/data/*
!/data/verified-station-coordinates.csv
!/data/station-coordinate-report.md
!/data/station-coordinate-report.json
!/data/coordinate-sources/
/data/coordinate-sources/*
!/data/coordinate-sources/merged.json
!/data/coordinate-sources/unresolved.json
!/data/coordinate-sources/duplicate-sites.json
!/data/coordinate-sources/status-exclusion-reviews.json

# Retain one live validation record; debugging and cached runs remain local
!/data/live-verified-stations/
/data/live-verified-stations/*
!/data/live-verified-stations/validation.json

