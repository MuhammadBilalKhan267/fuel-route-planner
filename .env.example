DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ORS_API_KEY=
# Optional: offline station research only; trip requests do not use TomTom.
TOMTOM_API_KEY=
DEFAULT_INITIAL_FUEL_GALLONS=50
DEFAULT_INITIAL_FUEL_PRICE_USD=0
DEFAULT_VERIFY_STOPS=true
DEFAULT_STATION_CORRIDOR_MILES=2
MAP_TILE_URL=https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}
MAP_TILE_ATTRIBUTION=USGS The National Map
